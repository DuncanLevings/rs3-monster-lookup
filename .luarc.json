{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "runtime.path": [
    "?.lua",
    "?/init.lua"
  ],
  "diagnostics.globals": [
    "log",
    "PluginShutdown",
    "PluginDependencyUpdate",
    "gepl",
    "Event",
    "MiniMenuActionVerbType",
    "prettyui",
    "ui",
    "id",
    "config",
    "PersistentDB",
    "GameState",
    "HTTPRequest",
    "Plugin",
    "PluginPermissions",
    "HintList",
    "CoordGrid",
    "CoordFine",
    "World",
    "Player",
    "LocList",
    "Vector3",
    "var"
  ],
  "workspace.checkThirdParty": false,
  "workspace.ignoreDir": [
    ".git",
    "dist",
    "work",
    "src/vendor",
    "src/data/bundle"
  ]
}
